# Backend settings use the ENTERPRISE_RAG_ prefix.
ENTERPRISE_RAG_ACCESS_MODE=open
# Production demo mode also requires DEMO_PASSWORD_HASH, SESSION_SECRET, and COOKIE_SECURE=true.
ENTERPRISE_RAG_SESSION_EXPIRY_MINUTES=120
ENTERPRISE_RAG_DATABASE_URL=sqlite:///./data/enterprise_rag.db
ENTERPRISE_RAG_STORAGE_PATH=./data/uploads
ENTERPRISE_RAG_MODEL_CACHE_PATH=./data/models
ENTERPRISE_RAG_LANGCHAIN_INDEX_PATH=./data/langchain_indexes
ENTERPRISE_RAG_MAX_UPLOAD_MB=50
ENTERPRISE_RAG_MAX_UPLOAD_BYTES=52428800
ENTERPRISE_RAG_MAX_MEDIA_UPLOAD_BYTES=52428800
ENTERPRISE_RAG_MAX_DOCUMENT_PAGES=300
ENTERPRISE_RAG_MAX_MEDIA_DURATION_MINUTES=30
ENTERPRISE_RAG_MAX_FILES_PER_KNOWLEDGE_BASE=25
ENTERPRISE_RAG_MAX_KNOWLEDGE_BASES=5
ENTERPRISE_RAG_MAX_CONCURRENT_UPLOADS=2
ENTERPRISE_RAG_MAX_CONCURRENT_HEAVY_OPERATIONS=1
ENTERPRISE_RAG_HEAVY_QUEUE_MAX_SIZE=2
ENTERPRISE_RAG_REQUEST_BODY_LIMIT_MB=55
ENTERPRISE_RAG_TEMP_FILE_RETENTION_HOURS=12
ENTERPRISE_RAG_DEMO_DATA_RETENTION_HOURS=24
ENTERPRISE_RAG_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=120
ENTERPRISE_RAG_MEDIA_PROCESSING_TIMEOUT_SECONDS=1800
# Optional read-only Netscape cookie source. yt-dlp uses a private writable runtime copy.
# ENTERPRISE_RAG_YTDLP_COOKIES_FILE=/run/secrets/youtube-cookies.txt
ENTERPRISE_RAG_CORS_ORIGINS=["http://localhost:5173"]
ENTERPRISE_RAG_CHUNK_SIZE=800
ENTERPRISE_RAG_CHUNK_OVERLAP=120
ENTERPRISE_RAG_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
ENTERPRISE_RAG_EMBEDDING_BATCH_SIZE=32
ENTERPRISE_RAG_GENERATION_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
ENTERPRISE_RAG_GENERATION_FALLBACK_MODEL_NAME=google/flan-t5-base
ENTERPRISE_RAG_MODEL_DEVICE=auto
ENTERPRISE_RAG_HF_LOCAL_FILES_ONLY=false
# These unprefixed names are also accepted for direct course compatibility.
RAG_ENGINE=custom
MODEL_QUANTIZATION=none
ENTERPRISE_RAG_RETRIEVAL_TOP_K=5
ENTERPRISE_RAG_RETRIEVAL_CANDIDATE_POOL=40
ENTERPRISE_RAG_SIMILARITY_THRESHOLD=0.2
ENTERPRISE_RAG_DENSE_SCORE_WEIGHT=0.45
ENTERPRISE_RAG_LEXICAL_SCORE_WEIGHT=0.30
ENTERPRISE_RAG_RERANK_SCORE_WEIGHT=0.25
ENTERPRISE_RAG_NEAR_DUPLICATE_THRESHOLD=0.88
ENTERPRISE_RAG_MINIMUM_QUERY_COVERAGE=0.16
ENTERPRISE_RAG_MAXIMUM_SOURCES_PER_DOCUMENT=3
ENTERPRISE_RAG_GENERATION_TEMPERATURE=0.1
ENTERPRISE_RAG_GENERATION_TOP_K=50
ENTERPRISE_RAG_GENERATION_TOP_P=0.9
ENTERPRISE_RAG_GENERATION_MAX_NEW_TOKENS=256
ENTERPRISE_RAG_GENERATION_REPETITION_PENALTY=1.0
ENTERPRISE_RAG_GENERATION_DO_SAMPLE=true
ENTERPRISE_RAG_LANGCHAIN_PARSER_RETRIES=1
ENTERPRISE_RAG_MAX_CONTEXT_CHARACTERS=12000
ENTERPRISE_RAG_CONVERSATION_HISTORY_MESSAGES=6
ENTERPRISE_RAG_TRANSCRIPTION_MODEL_NAME=small
ENTERPRISE_RAG_TRANSCRIPTION_DEVICE=cpu
ENTERPRISE_RAG_TRANSCRIPTION_COMPUTE_TYPE=int8
ENTERPRISE_RAG_TRANSCRIPTION_LANGUAGE=auto
ENTERPRISE_RAG_TRANSCRIPTION_CPU_THREADS=4
ENTERPRISE_RAG_TRANSCRIPTION_NUM_WORKERS=1
ENTERPRISE_RAG_TRANSCRIPTION_BEAM_SIZE=3

# ── Runtime profile (low_memory | balanced | quality | aws_cpu | huggingface_demo)
# Set to low_memory for 8 GB Apple Silicon machines.
# APP_RUNTIME_PROFILE=balanced

# ── Concurrency & timeouts ──────────────────────────────────────────
# ENTERPRISE_RAG_MAX_CONCURRENT_GENERATIONS=2
# ENTERPRISE_RAG_GENERATION_TIMEOUT_SECONDS=90
# ENTERPRISE_RAG_GENERATION_QUEUE_TIMEOUT_SECONDS=120

# ── Intelligence operation bounds ────────────────────────────────────
# ENTERPRISE_RAG_COMPARISON_MAX_CONTEXT_CHARACTERS=8000
# ENTERPRISE_RAG_COMPARISON_TIMEOUT_SECONDS=120
# ENTERPRISE_RAG_REPORT_TIMEOUT_SECONDS=180
# ENTERPRISE_RAG_SUMMARY_TIMEOUT_SECONDS=60
# ENTERPRISE_RAG_INTELLIGENCE_MAX_NEW_TOKENS=256

# ── LangChain model sharing ─────────────────────────────────────────
# Force LangChain to reuse the existing generation provider.
# ENTERPRISE_RAG_LANGCHAIN_FORCE_WRAPPER=false

# ── Model lifecycle and CPU bounds ──────────────────────────────────
# ENTERPRISE_RAG_WARM_MODELS_ON_STARTUP=false
# ENTERPRISE_RAG_WARM_GENERATION_MODEL_ON_STARTUP=true
# ENTERPRISE_RAG_TORCH_NUM_THREADS=2
# ENTERPRISE_RAG_TORCH_NUM_INTEROP_THREADS=1
# ENTERPRISE_RAG_QUERY_EMBEDDING_CACHE_SIZE=128
