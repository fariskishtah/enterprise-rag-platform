# ──────────────────────────────────────────────────────────────────────
# EnterpriseRAG — Recommended 8 GB Apple Silicon Configuration
# ──────────────────────────────────────────────────────────────────────
# For local Uvicorn started from backend/, copy this file to backend/.env.
# Its relative paths are host-development paths, not container persistence settings.
# This profile is optimised for a MacBook Air with 8 GB unified memory.

# ── Runtime profile ──────────────────────────────────────────────────
APP_RUNTIME_PROFILE=low_memory

# ── RAG engine ───────────────────────────────────────────────────────
RAG_ENGINE=custom

# ── Database & storage ───────────────────────────────────────────────
ENTERPRISE_RAG_DATABASE_URL=sqlite:///./data/enterprise_rag.db
ENTERPRISE_RAG_STORAGE_PATH=./data/uploads
ENTERPRISE_RAG_MODEL_CACHE_PATH=./data/models

# ── Models ───────────────────────────────────────────────────────────
ENTERPRISE_RAG_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
ENTERPRISE_RAG_GENERATION_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
ENTERPRISE_RAG_GENERATION_FALLBACK_MODEL_NAME=google/flan-t5-base
ENTERPRISE_RAG_MODEL_DEVICE=auto
MODEL_QUANTIZATION=none

# ── Generation bounds ────────────────────────────────────────────────
ENTERPRISE_RAG_GENERATION_MAX_NEW_TOKENS=128
ENTERPRISE_RAG_GENERATION_TEMPERATURE=0.1
ENTERPRISE_RAG_GENERATION_DO_SAMPLE=true

# ── Retrieval bounds ─────────────────────────────────────────────────
ENTERPRISE_RAG_RETRIEVAL_TOP_K=3
ENTERPRISE_RAG_RETRIEVAL_CANDIDATE_POOL=20
ENTERPRISE_RAG_MAX_CONTEXT_CHARACTERS=4000
ENTERPRISE_RAG_SIMILARITY_THRESHOLD=0.2

# ── Concurrency & timeouts ──────────────────────────────────────────
ENTERPRISE_RAG_MAX_CONCURRENT_GENERATIONS=1
ENTERPRISE_RAG_GENERATION_TIMEOUT_SECONDS=45
ENTERPRISE_RAG_GENERATION_QUEUE_TIMEOUT_SECONDS=60

# ── Intelligence operation bounds ────────────────────────────────────
ENTERPRISE_RAG_COMPARISON_MAX_CONTEXT_CHARACTERS=3000
ENTERPRISE_RAG_COMPARISON_TIMEOUT_SECONDS=90
ENTERPRISE_RAG_REPORT_TIMEOUT_SECONDS=120
ENTERPRISE_RAG_REPORT_SECTION_TIMEOUT_SECONDS=45
ENTERPRISE_RAG_SUMMARY_TIMEOUT_SECONDS=45
ENTERPRISE_RAG_INTELLIGENCE_MAX_NEW_TOKENS=160

# ── LangChain ────────────────────────────────────────────────────────
# Force the LangChain wrapper to reuse the existing generation provider
# instead of loading a second model instance.
ENTERPRISE_RAG_LANGCHAIN_FORCE_WRAPPER=true
ENTERPRISE_RAG_LANGCHAIN_PARSER_RETRIES=0

# ── Transcription (CPU to avoid MPS memory competition) ──────────────
ENTERPRISE_RAG_TRANSCRIPTION_MODEL_NAME=small
ENTERPRISE_RAG_TRANSCRIPTION_DEVICE=cpu
ENTERPRISE_RAG_TRANSCRIPTION_COMPUTE_TYPE=int8
ENTERPRISE_RAG_TRANSCRIPTION_CPU_THREADS=4
ENTERPRISE_RAG_TRANSCRIPTION_LANGUAGE=auto
ENTERPRISE_RAG_TRANSCRIPTION_NUM_WORKERS=1
ENTERPRISE_RAG_TRANSCRIPTION_BEAM_SIZE=3

# ── Conversation ─────────────────────────────────────────────────────
ENTERPRISE_RAG_CONVERSATION_HISTORY_MESSAGES=4

# ── CORS ─────────────────────────────────────────────────────────────
ENTERPRISE_RAG_CORS_ORIGINS=["http://localhost:5173"]
