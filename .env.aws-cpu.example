# EnterpriseRAG — AWS Lightsail CPU profile (2 vCPU, 4 GB RAM, 4 GB swap)
# Copy to .env on the server. Do not add cookie contents to this file.
APP_RUNTIME_PROFILE=aws_cpu
RAG_ENGINE=custom
ENTERPRISE_RAG_ENVIRONMENT=production
ENTERPRISE_RAG_ACCESS_MODE=demo_password
# Required: generate a bcrypt hash offline; never place the plaintext password here.
ENTERPRISE_RAG_DEMO_PASSWORD_HASH=
# Required: at least 32 random characters, unique to this deployment.
ENTERPRISE_RAG_SESSION_SECRET=
ENTERPRISE_RAG_SESSION_EXPIRY_MINUTES=120
ENTERPRISE_RAG_COOKIE_SECURE=true

# Persistent Docker volumes
ENTERPRISE_RAG_DATABASE_URL=sqlite:////data/enterprise_rag.db
ENTERPRISE_RAG_STORAGE_PATH=/data/uploads
ENTERPRISE_RAG_LANGCHAIN_INDEX_PATH=/data/langchain_indexes
ENTERPRISE_RAG_MODEL_CACHE_PATH=/models/huggingface
HF_HOME=/models/huggingface

# Multilingual retrieval. Existing all-MiniLM indexes must be explicitly reindexed.
ENTERPRISE_RAG_EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
ENTERPRISE_RAG_EMBEDDING_BATCH_SIZE=8
ENTERPRISE_RAG_QUERY_EMBEDDING_CACHE_SIZE=128
ENTERPRISE_RAG_RETRIEVAL_TOP_K=3
ENTERPRISE_RAG_RETRIEVAL_CANDIDATE_POOL=12
ENTERPRISE_RAG_MAXIMUM_CONTEXT_CHARACTERS=3000

# CPU-only Qwen generation
ENTERPRISE_RAG_GENERATION_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
ENTERPRISE_RAG_MODEL_DEVICE=cpu
ENTERPRISE_RAG_MAXIMUM_NEW_TOKENS=96
ENTERPRISE_RAG_GENERATION_DO_SAMPLE=false
ENTERPRISE_RAG_GENERATION_TEMPERATURE=0
ENTERPRISE_RAG_MAX_CONCURRENT_GENERATIONS=1
ENTERPRISE_RAG_GENERATION_TIMEOUT_SECONDS=120
ENTERPRISE_RAG_GENERATION_QUEUE_TIMEOUT_SECONDS=180
ENTERPRISE_RAG_MAX_CONCURRENT_HEAVY_OPERATIONS=1
ENTERPRISE_RAG_HEAVY_QUEUE_MAX_SIZE=2
ENTERPRISE_RAG_SUMMARY_TIMEOUT_SECONDS=180
ENTERPRISE_RAG_TORCH_NUM_THREADS=2
ENTERPRISE_RAG_TORCH_NUM_INTEROP_THREADS=1
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false
CUDA_VISIBLE_DEVICES=

# Arabic/English transcription. Use small when accuracy matters more than latency/cache size.
ENTERPRISE_RAG_TRANSCRIPTION_MODEL_NAME=base
ENTERPRISE_RAG_TRANSCRIPTION_LANGUAGE=auto
ENTERPRISE_RAG_TRANSCRIPTION_DEVICE=cpu
ENTERPRISE_RAG_TRANSCRIPTION_COMPUTE_TYPE=int8
ENTERPRISE_RAG_TRANSCRIPTION_CPU_THREADS=2
ENTERPRISE_RAG_TRANSCRIPTION_NUM_WORKERS=1
ENTERPRISE_RAG_TRANSCRIPTION_BEAM_SIZE=3

# Optional YouTube authentication. Mount this source read-only; the app creates a private
# writable copy under /tmp for yt-dlp. Never store either cookie file in Git.
ENTERPRISE_RAG_YTDLP_COOKIES_FILE=/run/secrets/youtube-cookies.txt
ENTERPRISE_RAG_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=120
ENTERPRISE_RAG_MEDIA_PROCESSING_TIMEOUT_SECONDS=1800

# Keep health checks fast; warm manually from Settings after deployment if desired.
ENTERPRISE_RAG_WARM_MODELS_ON_STARTUP=false
ENTERPRISE_RAG_WARM_GENERATION_MODEL_ON_STARTUP=false
ENTERPRISE_RAG_UNLOAD_TRANSCRIPTION_MODEL_AFTER_USE=true
ENTERPRISE_RAG_TOKENIZER_PARALLELISM=false

# Public-demo upload, quota, retention, and request bounds
ENTERPRISE_RAG_MAX_UPLOAD_MB=50
ENTERPRISE_RAG_MAX_MEDIA_UPLOAD_BYTES=52428800
ENTERPRISE_RAG_MAX_DOCUMENT_PAGES=300
ENTERPRISE_RAG_MAX_MEDIA_DURATION_MINUTES=30
ENTERPRISE_RAG_MAX_FILES_PER_KNOWLEDGE_BASE=25
ENTERPRISE_RAG_MAX_KNOWLEDGE_BASES=5
ENTERPRISE_RAG_MAX_CONCURRENT_UPLOADS=2
ENTERPRISE_RAG_REQUEST_BODY_LIMIT_MB=55
ENTERPRISE_RAG_TEMP_FILE_RETENTION_HOURS=12
ENTERPRISE_RAG_DEMO_DATA_RETENTION_HOURS=24
ENTERPRISE_RAG_BACKUP_DIR=/backups
ENTERPRISE_RAG_BACKUP_RETENTION_DAYS=7
ENTERPRISE_RAG_CORS_ORIGINS=[]
